/* RP2350A (Raspberry Pi Pico 2) memory map. Verified against embassy-rp-0.10.0 build.rs and rp-pac-7.0.0.
   RP2350 replaces the BOOT2 second-stage bootloader (RP2040) with an IMAGE_DEF block (auto-generated by
   embassy-rp's lib.rs macro for feature "_rp235x", placed in the `.start_block` linker section by the PAC).
   FLASH: Full 4 MB addressable range (XIP at 0x10000000); this firmware uses the whole flash as one region.
   RAM: 512 KB (verified from rp-pac-7.0.0 OTP datasheet comments: SRAM 0x20000000..0x20082000). */
MEMORY {
    FLASH : ORIGIN = 0x10000000, LENGTH = 4M
    RAM   : ORIGIN = 0x20000000, LENGTH = 512K
}

/* For RP2350, place the IMAGE_DEF block (.start_block) between the vector table and .text,
   within the first 4 KB of flash (the RP2350 boot ROM scan window).
   After .start_block, recalculate _stext to account for the block's size. */
SECTIONS {
    .start_block (ADDR(.vector_table) + SIZEOF(.vector_table)) : ALIGN(4) {
        __start_block_addr = .;
        KEEP(*(.start_block));
        _stext_offset = .;
    } > FLASH
} INSERT BEFORE .text;

/* Override cortex-m-rt's default _stext to place .text after .start_block. */
_stext = _stext_offset;
