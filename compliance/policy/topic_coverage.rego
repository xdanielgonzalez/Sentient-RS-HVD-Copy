# MIL-STD-3071 topic-coverage gate.
#
# Input:  docs/compliance/tms/tms-coverage.json (generated by tools/tms-idl-codegen — the
#         per-type IDL type/topic catalogue; see that file's own `_generated` header).
# Data:   compliance/policy/data/tms_topic_classes.json (this project's hand-curated
#         Required/Conditional topic cross-reference, sourced from MIL-STD-3071 Table B.2 /
#         A.8.7 — see that file's `_source`/`_note`).
#
# What this checks: every topic MIL-STD-3071 classifies as Required, and every topic it
# classifies as Conditional (on one of the 10 named A.8.7 conditions), has a type binding in
# the generated catalogue -- i.e. tools/tms-idl-codegen actually parsed an IDL `@topic(...)`
# annotation for it and produced a shaped Rust type. This is TYPE-CATALOGUE coverage, not
# runtime publish-wiring coverage: a topic can pass this gate while bin-rpi never actually
# publishes it (see docs/tms-compliance.md's per-topic inventory + compliance/oscal's
# component-definition.json `bin-rpi` component for that separate, currently-manual axis).
#
# This is the machine-readable operationalization of "no type marked absent that the catalog
# requires" from the WS-R mission brief: tms-coverage.json has no explicit absent/implemented
# boolean, so "absent" is defined here as "no type in the catalogue carries this topic name in
# its `topics` array".
package main

import rego.v1

# input.types[] each look like:
#   { "name": ..., "module": ..., "idl_line": ..., "topics": [...], "fields": ..., ... }
topic_bound(topic) if {
	some t in input.types
	topic in t.topics
}

deny contains msg if {
	some topic in data.tms_topic_classes.required_topics
	not topic_bound(topic)
	msg := sprintf(
		"Required topic %q (MIL-STD-3071 Table B.2 / A.8.7 'Required. Implemented by all TMS devices') has NO type binding in tms-coverage.json -- the descriptor factory has never parsed an IDL @topic annotation for it",
		[topic],
	)
}

deny contains msg if {
	some topic, condition in data.tms_topic_classes.conditional_topics
	not topic_bound(topic)
	msg := sprintf(
		"Conditional topic %q (condition: %s -- MIL-STD-3071 A.8.7) has NO type binding in tms-coverage.json",
		[topic, condition],
	)
}
