# distro/deploy/cloud.env.example — template for /etc/sentient/cloud.env (root/mosquitto-owned, 0600).
#
# This is the ONLY place the private-cloud bridge password lives. It is never a TOML field, never
# committed to git, and never logged (see bin-rpi/src/config.rs's CloudConfig — there is no
# password field on that struct at all).
#
# Loaded by the mosquitto systemd override (distro/deploy/mosquitto-override.conf) via
# `EnvironmentFile=-/etc/sentient/cloud.env` before `bin-rpi --emit-mosquitto-bridge` runs.
#
# Install (real file, NOT this .example):
#   sudo install -o mosquitto -g mosquitto -m0600 cloud.env /etc/sentient/cloud.env
#
# Everything else about the cloud bridge (host, port, username, ca_file, remote_clientid, topic,
# qos) is NON-secret and lives in the [cloud] section of /etc/sentient/sentient.toml instead — see
# distro/deploy/config.example.toml and docs/deployment.md §9 ("Day-1 Sentient onboarding").

CLOUD_MQTT_PASS=REPLACE_WITH_THE_REAL_SENTIENT_CLOUD_BRIDGE_PASSWORD
